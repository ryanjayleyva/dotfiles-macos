[user]
	name = ryanjayleyva
	email = 331420123+ryanjayleyva@users.noreply.github.com
[init]
	defaultBranch = main
[core]
  editor = nvim
  pager = delta
	excludesfile = ~/.gitignore_global
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
  dark = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
